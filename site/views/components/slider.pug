extends ../layout



block title
    title #{title} | Frog UI CSS

block contents
    .page-wrapper
        section#tree
            .section-title
                h1= title
                .section-desc 
                    p !{cont("ELEMENTS_SLIDER_SUB_TITLE")}
            .section-contents
                h4.contents-title Base
                .ga-segment.float.round-m.attached
                    .contents-wrapper.py-10
                        .ga-slider
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                    .footer 
                        pre.code-wrapper
                            code.language-markup 
                                | #{codes.base}
            //.section-contents
                h4.contents-title BEUI style only
                .ga-segment.float.round-m.attached
                    .contents-wrapper.py-10
                        .ga-slider
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                                .tooltip 50
                    .contents-wrapper.py-10
                        .ga-slider
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                                .current-label 50
                    .footer 
                        pre.code-wrapper
                            code.language-markup 
                                | #{codes.base}
            .section-contents
                h4.contents-title Range
                .ga-segment.float.round-m.attached
                    .contents-wrapper.py-10
                        .ga-slider.range
                            input(type="range", hidden)
                            .result-slider
                            .control-btn.max
                            .control-btn.min
                    .footer 
                        pre.code-wrapper
                            code.language-markup 
                                | #{codes.range}
            .section-contents
                h4.contents-title No handle
                .ga-segment.float.round-m.attached
                    .contents-wrapper.py-10
                        .ga-slider.range.no-handle
                            input(type="range", hidden)
                            .result-slider
                            .control-btn.min
                            .control-btn.max
                    .footer 
                        pre.code-wrapper
                            code.language-markup 
                                | #{codes.noHandle}
            .section-contents
                h4.contents-title Disabled
                .ga-segment.float.round-m.attached
                    .contents-wrapper.py-10
                        .ga-slider.disabled
                            input(type="range", hidden)
                            .result-slider
                            .control-btn.max
                    .footer 
                        pre.code-wrapper
                            code.language-markup 
                                | #{codes.disabled}
            .section-contents
                h4.contents-title Show Label
                .ga-segment.float.round-m.attached
                    .contents-wrapper.py-10
                        .ga-slider
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                            .label-text 
                                .start-label 0
                                .end-label 100
                    .footer 
                        pre.code-wrapper
                            code.language-markup 
                                | #{codes.labels}
            .section-contents
                h4.contents-title Show Tooltip
                .ga-segment.float.round-m.attached
                    .contents-wrapper.py-10
                        .ga-slider.tooltip
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                            .label-text 
                                .start-label 0
                                .end-label 100
                    .footer 
                        pre.code-wrapper
                            code.language-markup 
                                | #{codes.tooltip}
            .section-contents
                h4.contents-title Show Result
                .ga-segment.float.round-m.attached
                    .contents-wrapper.py-10
                        .ga-slider.show-result
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                            .label-text 
                                .start-label 0
                                .end-label 100
                    .footer 
                        pre.code-wrapper
                            code.language-markup 
                                | #{codes.result}
            .section-contents
                h4.contents-title Unit Text
                .ga-segment.float.round-m.attached
                    .contents-wrapper.py-10
                        .ga-slider(data-unit="%").show-result
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                            .label-text 
                                .start-label 0%
                                .end-label 100%
                    .footer 
                        pre.code-wrapper
                            code.language-markup 
                                | #{codes.unit}
            .section-contents
                h4.contents-title Track Type
                .ga-segment.float.round-m.attached
                    .contents-wrapper
                        h5 Thin
                        .ga-slider.thin
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                        h5 (Default)
                        .ga-slider
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                        h5 Fat
                        .ga-slider.fat
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                            
                    .footer 
                        pre.code-wrapper
                            code.language-markup 
                                | #{codes.track}
            .section-contents
                h4.contents-title Colors
                .ga-segment.float.round-m.attached
                    .contents-wrapper
                        .ga-slider.tooltip.red
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                        .ga-slider.tooltip.orange
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                        .ga-slider.tooltip.yellow
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                        .ga-slider.tooltip.green
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                        .ga-slider.tooltip.blue
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                        .ga-slider.tooltip.deepblue
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                        .ga-slider.tooltip.purple
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                        .ga-slider.tooltip.lightblue
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                        .ga-slider.tooltip.lightgreen
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                        .ga-slider.tooltip.brown
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                    .footer 
                        pre.code-wrapper
                            code.language-markup 
                                | #{codes.colors}
block module 
    script(src="/js/slider.js")
        