extends ../layout



block title
    title #{title} | Frog UI CSS

block contents
    .page-wrapper
        section#tree
            .section-title
                h1= title
                .section-desc 
                    p !{cont("ELEMENTS_SLIDER_SUB_TITLE")}
            .section-contents
                h4.contents-title Base
                .ga-segment.float.round-m.attached
                    .contents-wrapper.py-10
                        .ga-slider(fr-slider="end: 80;")
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                    .footer 
                        pre.code-wrapper
                            code.language-markup 
                                | #{codes.base}
            //- .section-contents
                h4.contents-title BEUI style only
                .ga-segment.float.round-m.attached
                    .contents-wrapper.py-10
                        .ga-slider
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                                .tooltip 50
                    .contents-wrapper.py-10
                        .ga-slider
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                                .current-label 50
                    .footer 
                        pre.code-wrapper
                            code.language-markup 
                                | #{codes.base}
            .section-contents
                h4.contents-title Range
                .ga-segment.float.round-m.attached
                    .contents-wrapper.py-10
                        .ga-slider(fr-slider="range: true; start: 10; end: 60;")
                            input(type="range", hidden)
                            .result-slider
                            .control-btn.max
                            .control-btn.min
                    .footer 
                        pre.code-wrapper
                            code.language-markup 
                                | #{codes.range}
            .section-contents
                h4.contents-title No handle
                .ga-segment.float.round-m.attached
                    .contents-wrapper.py-10
                        .ga-slider(fr-slider="range: true; no-handle: true; start: 10; end: 60")
                            input(type="range", hidden)
                            .result-slider
                            .control-btn.min
                            .control-btn.max
                    .footer 
                        pre.code-wrapper

                            code.language-markup 
                                | #{codes.noHandle}
            .section-contents
                h4.contents-title Clipper
                .ga-segment.float.round-m.attached
                    .contents-wrapper.py-10
                        .ga-slider(fr-slider="clipper: true; range: true;")
                            input(type="range", hidden)
                            .result-slider
                            .control-btn.min
                            .control-btn.max
                    .footer 
                        pre.code-wrapper
                            code.language-markup 
                                | #{codes.base}
            .section-contents
                h4.contents-title Disabled
                .ga-segment.float.round-m.attached
                    .contents-wrapper.py-10
                        .ga-slider(fr-slider="end: 50; disabled: true;")
                            input(type="range", hidden)
                            .result-slider
                            .control-btn.max
                    .footer 
                        pre.code-wrapper
                            code.language-markup 
                                | #{codes.disabled}
            .section-contents
                h4.contents-title Show Label
                .ga-segment.float.round-m.attached
                    .contents-wrapper.py-10
                        .ga-slider(fr-slider)
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                            .label-text 
                                .start-label 0
                                .end-label 100
                    .footer 
                        pre.code-wrapper
                            code.language-markup 
                                | #{codes.labels}
            .section-contents
                h4.contents-title Show Tooltip
                .ga-segment.float.round-m.attached
                    .contents-wrapper.py-10
                        .ga-slider(fr-slider="tooltip: true; end: 56;")
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                            .label-text 
                                .start-label 0
                                .end-label 100
                    .footer 
                        pre.code-wrapper
                            code.language-markup 
                                | #{codes.tooltip}
            .section-contents
                h4.contents-title Show Result
                .ga-segment.float.round-m.attached
                    .contents-wrapper.py-10
                        .ga-slider.show-result(fr-slider="end: 45; showResult: true")
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                            .label-text 
                                .start-label 0
                                .end-label 100
                    .footer 
                        pre.code-wrapper
                            code.language-markup 
                                | #{codes.result}
            .section-contents
                h4.contents-title Unit Text
                .ga-segment.float.round-m.attached
                    .contents-wrapper.py-10
                        .ga-slider(data-unit="%", fr-slider="end: 50").show-result
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                            .label-text 
                                .start-label 0%
                                .end-label 100%
                    .footer 
                        pre.code-wrapper
                            code.language-markup 
                                | #{codes.unit}
            .section-contents
                h4.contents-title Steps
                .ga-segment.float.round-m.attached
                    .contents-wrapper.py-10
                        .ga-slider(data-unit="%", fr-slider="end: 50").show-result
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                            .break-points
                                - for (var i = 0; i <= 10; i++)
                                    .break-point(style=`left: ${i * 10}%`, data-step=`${i * 10}`)

                    .footer 
                        pre.code-wrapper
                            code.language-markup 
                                | #{codes.unit}
            .section-contents
                h4.contents-title Track Type
                .ga-segment.float.round-m.attached
                    .contents-wrapper
                        h5 Thin
                        .ga-slider.thin(fr-slider="end: 50")
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                        h5 (Default)
                        .ga-slider(fr-slider="end: 50")
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                        h5 Fat
                        .ga-slider.fat(fr-slider="end: 50")
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                            
                    .footer 
                        pre.code-wrapper
                            code.language-markup 
                                | #{codes.track}
            .section-contents
                h4.contents-title Colors
                .ga-segment.float.round-m.attached
                    .contents-wrapper
                        .ga-slider.tooltip.red(fr-slider="end: 10")
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                        .ga-slider.tooltip.orange(fr-slider="end: 20")
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                        .ga-slider.tooltip.yellow(fr-slider="end: 30")
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                        .ga-slider.tooltip.green(fr-slider="end: 40")
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                        .ga-slider.tooltip.blue(fr-slider="end: 50")
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                        .ga-slider.tooltip.deepblue(fr-slider="end: 60")
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                        .ga-slider.tooltip.purple(fr-slider="end: 70")
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                        .ga-slider.tooltip.lightblue(fr-slider="end: 80")
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                        .ga-slider.tooltip.lightgreen(fr-slider="end: 90")
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                        .ga-slider.tooltip.brown(fr-slider="end: 100")
                            input(type="range", hidden)
                            .result-slider
                            .control-btn
                    .footer 
                        pre.code-wrapper
                            code.language-markup 
                                | #{codes.colors}
//- block module 
    script(src="/js/slider.js")
        