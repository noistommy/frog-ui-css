block module
    script.
        class Breadcrumb {
            #defaultOption = {
                round: false,
                compact: false,
                noHover: false,
                mark: null,
                ellipsis: true,
                tooltip: true
            }
            constructor(root, options = {}) {
                this.root = root
                this.options = {...this.#defaultOption, ...options}
                this._pages = [
                   { name: 'Home', path: '/'} 
                ]
                this.setClass ()
                this.setBreadcrumb()
            }
            setClass () {
                const classes =  [
                    this.options.round && 'round',
                    this.options.compact && 'compact',
                    this.options.noHover && 'no-hover',
                ].filter(t  => t)

                this.root.classList.add(...classes)
            }
            setBreadcrumb () {
                if (this._pages.length < 1) return
                this.root.textContent = '';
                this._pages.forEach((page, i) => {
                    const listItem = document.createElement('li');
                    if (this.options.mark) {
                        listItem.dataset.split = this.options.mark
                    }
                    let link;
                    if (i < this._pages.length - 1) {
                        link = document.createElement('a');
                        link.setAttribute('href', page.path);
                        link.innerHTML = page.icon ? `<i class="icon left ${page.icon}"></i> ${page.name}` : page.name 
                        if (this.options.ellipsis) {
                            link.classList.add('ellipsis')
                            if (this.options.tooltip) {
                                link.setAttribute('fr-tooltip', `content: ${page.name}`)
                            }
                        }
                        listItem.append(link)
                    } else {
                        link = document.createElement('span');
                        link.innerHTML= page.icon ? `<i class="icon left ${page.icon}"> </i> ${page.name}` : page.name 
                        listItem.append(link)
                        listItem.classList.add('current')
                    }
                    this.root.append(listItem)
                })
            }

            set setPages (pages) {
                this._pages = pages
                this.setBreadcrumb()
            }
        }
        (function () {
            const breadcrumbs = document.querySelectorAll('[fr-breadcrumb]');
            const pages = [
                {name: 'Home', path: '/', icon: 'xi-home'},
                {name: 'Pagedfkgjsdfg;lkfghl;kkfgsld;dk;ldgfhfghdfg', path: '/', icon: 'xi-browser-text'},
                {name: 'Current', path: '', icon: 'xi-marker'},
            ]

            //- const options = {pages}
            breadcrumbs.forEach((breadcrumb) => {
                const options = parseOptions(breadcrumb.getAttribute('fr-breadcrumb'))
                const bc = new Breadcrumb(breadcrumb, options)
                bc.setPages = pages
            })
        })()