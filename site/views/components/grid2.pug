extends ../layout

block title
    title #{title} | Frog UI CSS

block contents
    .page-wrapper
        section#grid
            .section-title
                h1= title
                .section-desc
                    p !{cont("LAYOUT_GRID2_SUB_TITLE")}
            .section-contents
                h4.contents-title Base
                .ga-segment.float.round-m.attached
                    .contents-wrapper
                        .ga-grid2.divide-column-8.row-2
                            each col in [1, 2, 3, 4, 5, 6]
                                .column
                            each col in [1, 2, 3, 4, 5, 6]
                                .column
                    .footer
                        pre
                            code.language-markup
                                | #{codes.base}
            .section-contents
                h4.contents-title Dosirak
                .ga-segment.float.round-m.attached
                    .contents-wrapper
                        .ga-grid2.dosirak.set-rows(style="--grid-col-num: 4; --grid-row-num: 3; --rows-height: 10rem")
                            each col in [[2, 1],[1, 1],[1, 2],[1, 1],[2, 1],]
                                .column(class=`col-${col[0]} row-${col[1]}`)
                    .footer
                        pre
                            code.language-markup
                                | #{codes.dosirak}
            .section-contents
                h4.contents-title Divide
                .ga-segment.float.round-m.attached
                    .contents-wrapper
                        .ga-grid2.divide-column-4
                            .column
                            .column
                            .column
                            .column
                            .column
                            .column
                            .column
                            .column
                            .column
                            .column
                            .column
                            .column
                    .footer
                        pre
                            code.language-markup
                                | #{codes.divide}
            .section-contents
                h4.contents-title Widths
                .ga-segment.float.round-m.attached
                    .contents-wrapper
                        .ga-grid2
                            .column.col-1
                            .column.col-3
                            .column.col-2
                            .column.col-6
                            .column.col-6
                            .column.col-6
                            .column.col-3
                            .column.col-3
                            .column.col-3
                            .column.col-3
                            .column.col-2
                            .column.col-10
                    .footer
                        pre
                            code.language-markup
                                | #{codes.widths}
            .section-contents
                h4.contents-title Widths (+ROW)
                .ga-segment.float.round-m.attached
                    .contents-wrapper
                        .ga-grid2.set-rows(style="--grid-row-num: 9")
                            .column.col-6.row-6(data-index=0)
                            .column.col-6.row-4(data-index=1)
                            .column.col-6.row-2(data-index=2)
                            .column.col-12(data-index=3)
                            .column.col-6.row-2(data-index=4)
                            .column.col-6.row-2(data-index=5)
                            
                    .footer
                        pre
                            code.language-markup
                                | #{codes.widthRow}
            .section-contents
                h4.contents-title Flow column
                .ga-segment.float.round-m.attached
                    .contents-wrapper
                        .ga-grid2.set-rows(style="--grid-row-num: 9").flow-column
                            .column.col-6.row-6(data-index=0)
                            .column.col-6.row-4(data-index=1)
                            .column.col-6.row-2(data-index=2)
                            .column.col-12(data-index=3)
                            .column.col-6.row-2(data-index=4)
                            .column.col-6.row-2(data-index=5)
                    .footer
                        pre
                            code.language-markup
                                | #{codes.flowColumn}
            .section-contents
                h4.contents-title Dense
                .ga-segment.float.round-m.attached
                    .contents-wrapper
                        .ga-grid2.set-rows(style="--grid-row-num: 9").dense
                            .column.col-6.row-6(data-index=0)
                            .column.col-6.row-4(data-index=1)
                            .column.col-6.row-2(data-index=2)
                            .column.col-8.row-2(data-index=3)
                            .column.col-8.row-2(data-index=4)
                            .column.col-4.row-2(data-index=5)
                    .footer
                        pre
                            code.language-markup
                                | #{codes.dense}
            .section-contents
                h4.contents-title Auto-fit
                .ga-segment.float.round-m.attached
                    .contents-wrapper
                        .ga-grid2.divide-column-10.auto-fit
                            .column
                            .column
                            .column
                            .column
                    .footer
                        pre
                            code.language-markup
                                | #{codes.autoFit}