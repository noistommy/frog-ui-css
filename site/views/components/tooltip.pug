extends ../layout

block title
    title #{title} | Frog UI CSS

block contents
    .page-wrapper
        section
            .section-title
                h1= title
                .section-desc 
                    p !{cont("MODULES_TOOLTIP_SUB_TITLE")}
                .section-tag.p-4
                    .ga-tags.attached
                        .ga-tag.label.deepblue fr-tooltip
                        .ga-tag.label.lightblue JS
            .section-contents
                h4.contents-title Base
                .ga-segment.float.round-m
                    .contents-wrapper.ga.flex.center
                        .ga-button(fr-tooltip="content: Base Tooltip!") Base 
                    .footer
                            pre
                                code.language-markup
                                    | #{codes.base}
            .section-contents
                h4.contents-title Invert
                .ga-segment.float.round-m
                    .contents-wrapper.ga.flex.center
                        .ga-button(fr-tooltip="content: Equal Theme; invert: false") Equal Theme
                        .ga-button(fr-tooltip="content: Invert Theme;") Invert Theme            
                    .footer
                            pre
                                code.language-markup
                                    | #{codes.theme}
            .section-contents
                h4.contents-title Trigger
                .ga-segment.float.round-m
                    .contents-wrapper.ga.flex.center
                        .ga-button(fr-tooltip="content: Hover;") Hover 
                        .ga-button(fr-tooltip="content: Dark; trigger: click") Click
                    .footer
                            pre
                                code.language-markup
                                    | #{codes.trigger}
            .section-contents
                h4.contents-title Contents Type
                p.contents-desc.py-8 [fr-target] 속성이 지정된 html source를 tooltip 컨텐츠로 활용 가능합니다. 
                .ga-segment.float.round-m
                    .contents-wrapper.ga.flex.center
                        .ga-button(fr-tooltip="content: content: {contents...}") Attr: content 
                        .ga-button(fr-tooltip) 
                            | Target
                            span(fr-target)
                                .title.bold.ga-yellow-text TItle 
                                p.ga-lightblue-text Html Contents
                    .footer
                            pre
                                code.language-markup
                                    | #{codes.contentType}
            .section-contents
                h4.contents-title Position
                p.contents-desc.py-8 pos 속성은 기본적으로 '{direct}-{align}' 구조로 적용 합니다. 예를들면 'top-center', 'left-start' 처럼, 하지만 가운데 정렬을 기본 값으로 두고 position만 입력하더라도 동작 가능합니다. 
                .ga-segment.float.round-m
                    .contents-wrapper.ga.flex.center
                        .ga-button(fr-tooltip="content: Top; pos: top") 
                            i.icon.left.xi-arrow-up
                            | Top 
                        .ga-button(fr-tooltip="content: Bottom; pos: bottom") 
                            i.icon.left.xi-arrow-down
                            | Bottom 
                        .ga-button(fr-tooltip="content: Left; pos: left") 
                            i.icon.left.xi-arrow-left
                            | Left 
                        .ga-button(fr-tooltip="content: Right; pos: right") 
                            i.icon.left.xi-arrow-right
                            | Right 
                    .footer
                            pre
                                code.language-markup
                                    | #{codes.position}
            .section-contents
                h4.contents-title Position and Align
                .ga-segment.float.round-m
                    .contents-wrapper
                        - const lorem = "Lorem, ipsum dolor sit amet consectetur adipisicing elit. Corrupti tempore necessitatibus nam delectus illum qui tenetur fuga, iure id a voluptas. Neque qui quo alias nulla odit adipisci suscipit totam."
                        .ga-grid2
                            .column.col-3.col-xs-12
                                .ga-button.text.fluid Top | Left
                            .column.col-6.col-xs-12
                                .ga.grow.flex
                                    .ga-button(fr-tooltip="pos: top-end") 
                                        | T-END
                                        span(fr-target)
                                            .title  TOP-END
                                            .desc= lorem
                                    .ga-button(fr-tooltip="pos: top-center") 
                                        | T-CENTER
                                        span(fr-target)
                                            .title  TOP-CENTER
                                            .desc= lorem
                                    .ga-button(fr-tooltip="pos: top-start") 
                                        | T-START 
                                        span(fr-target)
                                            .title  TOP-START
                                            .desc= lorem
                            .column.col-3.col-xs-12
                                .ga-button.text.fluid Top | Right
                            
                            .column.col-3.col-xs-12
                                .ga-button.fluid(fr-tooltip="pos: left-end") 
                                    | L-END
                                    span(fr-target)
                                        .title  LEFT-END
                                        .desc= lorem
                            .column.col-6.col-xs-12
                            .column.col-3.col-xs-12
                                .ga-button.fluid(fr-tooltip="pos: right-end") 
                                    | R-END
                                    span(fr-target)
                                        .title  RIGHT-END
                                        .desc= lorem
                            
                            
                            .column.col-3.col-xs-12
                                .ga-button.fluid(fr-tooltip="pos: left-center") 
                                    | L-CENTET
                                    span(fr-target)
                                        .title  LEFT-CENTER
                                        .desc= lorem
                            .column.col-6.col-xs-12
                            .column.col-3.col-xs-12
                                .ga-button.fluid(fr-tooltip="pos: right-center") 
                                    | R-CENTET
                                    span(fr-target)
                                        .title  RIGHT-CENTER
                                        .desc= lorem
                            
                            
                            .column.col-3.col-xs-12
                                .ga-button.fluid(fr-tooltip="pos: left-start") 
                                    | L-START
                                    span(fr-target)
                                        .title  LEFT-START
                                        .desc= lorem
                            .column.col-6.col-xs-12
                            .column.col-3.col-xs-12
                                .ga-button.fluid(fr-tooltip="pos: right-start") 
                                    | R-START
                                    span(fr-target)
                                        .title  RIGHT-START
                                        .desc= lorem
                            .column.col-3.col-xs-12
                                .ga-button.text.fluid Bottom | Left
                            .column.col-6.col-xs-12
                                .ga.grow.flex
                                    .ga-button(fr-tooltip="pos: bottom-end") 
                                        | B-END
                                        span(fr-target)
                                            .title  BOTTOM-END
                                            .desc= lorem
                                    .ga-button(fr-tooltip="pos: bottom-center") 
                                        | B-CENTER
                                        span(fr-target)
                                            .title  BOTTOM-CENTER
                                            .desc= lorem
                                    .ga-button(fr-tooltip="pos: bottom-start") 
                                        | B-START
                                        span(fr-target)
                                            .title  BOTTOM-START
                                            .desc= lorem
                            .column.col-3.col-xs-12
                                .ga-button.text.fluid Bottom | Right
                    .footer
                            pre
                                code.language-markup
                                    | #{codes.aligns}
            .section-contents
                h4.contents-title Offset
                .ga-segment.float.round-m
                    .contents-wrapper.ga.flex.center
                        .ga-button(fr-tooltip="content: Offset 10; offset: 10") Offset 10px 
                        .ga-button(fr-tooltip="content: Offset 20; offset: 20") Offset 20px 
                        .ga-button(fr-tooltip="content: Offset 0; offset: 0") Offset 0px 
                        .ga-button(fr-tooltip="content: Offset -10; offset: -10") Offset -10px 
                    .footer
                            pre
                                code.language-markup
                                    | #{codes.offset}
            .section-contents
                h4.contents-title Size
                .ga-segment.float.round-m
                    .contents-wrapper.ga.flex.center
                        .ga-button(fr-tooltip="content: Normal size;") Normal
                        .ga-button(fr-tooltip="content: Small size; size: small") Small
                    .footer
                            pre
                                code.language-markup
                                    | #{codes.size}
            .section-contents
                h4.contents-title Max width
                .ga-segment.float.round-m
                    .contents-wrapper.ga.flex.center
                        .ga-button(fr-tooltip="maxWidth: 150") Max Width 150
                            span(fr-target)
                                .title  Width 150px
                                .desc= lorem
                        .ga-button(fr-tooltip="maxWidth: 250") Max Width 250
                            span(fr-target)
                                .title  Width 250px
                                .desc= lorem
                        .ga-button(fr-tooltip="maxWidth: 500") Max Width 500
                            span(fr-target)
                                .title  Width 500px
                                .desc= lorem
                    .footer
                            pre
                                code.language-markup
                                    | #{codes.maxWidth}
            .section-contents
                h4.contents-title Text Alignment
                .ga-segment.float.round-m
                    .contents-wrapper.ga.flex.center
                        .ga-button(fr-tooltip="textAlign: left") Align Left
                            span(fr-target)
                                .title  Align Left
                                .desc= lorem
                        .ga-button(fr-tooltip="textAlign: center") Align Center
                            span(fr-target)
                                .title  Align Left Center
                                .desc= lorem
                        .ga-button(fr-tooltip="textAlign: right") Align Right
                            span(fr-target)
                                .title  Align Right
                                .desc= lorem
                    .footer
                            pre
                                code.language-markup
                                    | #{codes.textAlign}
            .section-contents
                h4.contents-title Padding
                .ga-segment.float.round-m
                    .contents-wrapper.ga.flex.center
                        .ga-button(fr-tooltip="padding: 4") Padding 4
                            span(fr-target)
                                .title  padding: 4px
                                .desc= lorem
                        .ga-button(fr-tooltip="padding: 8") Padding 8
                            span(fr-target)
                                .title  padding: 8px
                                .desc= lorem
                        .ga-button(fr-tooltip="padding: 16") Padding 16
                            span(fr-target)
                                .title  padding: 16px
                                .desc= lorem
                        .ga-button(fr-tooltip="padding: 24") Padding 24
                            span(fr-target)
                                .title  padding: 24px
                                .desc= lorem
    
                    .footer
                            pre
                                code.language-markup
                                    | #{codes.padding}